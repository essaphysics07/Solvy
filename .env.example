# Keep your existing values in .env.local. Never commit that file.
GEMINI_API_KEY=
# Optional model overrides. These defaults match the uploaded working source.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Existing persistence configuration; no database migration is required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
